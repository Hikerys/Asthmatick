{
  "name": "asthmatick",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "build:apk": "npm run build && cap sync android && cd android && ./gradlew assembleRelease && mkdir -p ../releases && cp -f app/build/outputs/apk/release/app-release.apk ../releases/Asthmatick.apk && cp -f app/build/outputs/apk/release/app-release.apk ../Asthmatick.apk"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
